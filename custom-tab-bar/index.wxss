.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: calc(48px + env(safe-area-inset-bottom)); /* 组件高48pt + 底部安全区34pt */
  padding: 0 48rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-top: 2rpx solid #eee7d6;
  box-shadow: 0 -8rpx 36rpx rgba(117, 101, 43, 0.05);
  z-index: 10;
}

.tab-item {
  flex: 1;
  min-height: 88rpx; /* 点击热区 ≥44pt */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* icon 尺寸 24×24pt（48×48rpx） */
.tab-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-ico {
  width: 48rpx;
  height: 48rpx;
}


.tab-label {
  margin-top: 4rpx;
  font-size: 24rpx; /* 12pt */
  color: #8f896d;
}

.tab-label.active {
  color: #b97b05;
  font-weight: 700;
}

/* 中央大号悬浮加号（替换为设计稿图标，无文字） */
.tab-add {
  width: 164rpx;
  height: 164rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -64rpx;
  flex-shrink: 0;
}

.tab-add.active {
  filter: brightness(1.05);
}

/* 图标本体（含黄圆底 + 黑圆内黄加号） */
.tab-add-img {
  width: 164rpx;
  height: 164rpx;
}

/* 长按 + 语音录入浮层：位于 tabbar 上方，tabbar 保持显示 */
.voice-press {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 300rpx;
  z-index: 9999;
  display: flex;
  justify-content: center;
  pointer-events: none;
}
.vp-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 420rpx;
  padding: 48rpx 56rpx;
  background: rgba(41, 40, 31, 0.92);
  border-radius: 32rpx;
}
.vp-ico {
  font-size: 64rpx;
}
.vp-waves {
  display: flex;
  align-items: center;
  height: 64rpx;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.vp-bar {
  width: 10rpx;
  height: 24rpx;
  background: #ffd95a;
  border-radius: 6rpx;
  animation: vpwave 0.8s ease-in-out infinite;
}
.vp-bar:nth-child(2) { animation-delay: 0.15s; }
.vp-bar:nth-child(3) { animation-delay: 0.3s; }
.vp-bar:nth-child(4) { animation-delay: 0.45s; }
.vp-bar:nth-child(5) { animation-delay: 0.6s; }
@keyframes vpwave {
  0%, 100% { height: 24rpx; }
  50% { height: 60rpx; }
}
.vp-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
}
.vp-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #ffd95a;
}
