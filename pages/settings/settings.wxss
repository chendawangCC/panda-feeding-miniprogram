@import "../../pages/plan/plan.wxss";

/* 设置页容器（复用 plan 全量样式，仅覆盖页面级差异） */
.st-page {
  min-height: 100vh;
  background: #fffdf7;
}
.st-page .page-header-back {
  margin-bottom: 28rpx;
}
.st-account-card {
  margin: 16rpx 32rpx 8rpx;
}

/* ==================== 菜单头像（账号项） ==================== */
.st-acc-avatar {
  width: 72rpx;
  height: 72rpx;
  display: block;
  border-radius: 16rpx; /* 正方形圆角 */
}
.st-menu-card {
  margin: 16rpx 32rpx 0;
  background: #fff;
  border: 2rpx solid #eee7d6;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
}

/* 退出登录按钮 */
.st-delete {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border: 2rpx solid #f0e9d8;
  border-radius: 32rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #c14c2e;
}

.st-logout {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border: 2rpx solid #f0e9d8;
  border-radius: 32rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #c14c2e;
}

/* ==================== 数据导出面板 ==================== */
.exp-list {
  padding-top: 8rpx;
}
.exp-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #f7f2e4;
  border: 2rpx solid transparent;
}
.exp-item.on {
  background: #fff6d8;
  border-color: #ffd95a;
}
.exp-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid #d8cfb6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.exp-item.on .exp-check {
  background: #e2a93a;
  border-color: #e2a93a;
}
.exp-info {
  flex: 1;
  min-width: 0;
}
.exp-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #29281f;
}
.exp-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8f896d;
}
.exp-count {
  font-size: 22rpx;
  color: #b97b05;
  font-weight: 700;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.exp-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.exp-btn {
  flex: 1;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
  line-height: 88rpx;
}
.exp-btn.ghost {
  background: #f3efe2;
  color: #6b5c30;
}
.exp-btn.solid {
  background: #ffd95a;
  color: #5c4a10;
}
.exp-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b9b2a0;
}
.preview-box {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.preview-scroll {
  flex: 1;
  min-height: 200rpx;
  max-height: 60vh;
}
.preview-img {
  width: 100%;
  border-radius: 16rpx;
}
.preview-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 32rpx;
}
.export-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
}
.exp-btn-view { display: block; text-align: center; box-sizing: border-box; }
