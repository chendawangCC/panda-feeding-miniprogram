/* 与宝宝成长档案（baby-profile）表单样式保持一致 */
.measure-form {
  margin-top: 24rpx;
}
.form-row {
  margin-bottom: 24rpx;
}
.form-label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #8f896d;
  margin-bottom: 10rpx;
}
.form-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #f7f2e4;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #29281f;
}
.form-input.picker {
  display: flex;
  align-items: center;
  color: #4a4636;
}
.measure-slide {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.form-slider {
  flex: 1;
  margin: 0;
}
.measure-slide-val {
  display: flex;
  align-items: baseline;
  width: 150rpx;
  flex-shrink: 0;
  justify-content: flex-end;
}
.measure-slide-input {
  width: 96rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 700;
  color: #29281f;
  border-bottom: 2rpx solid #e5ddc8;
  padding: 6rpx 0;
}
.measure-slide-unit {
  font-size: 22rpx;
  color: #8f896d;
  margin-left: 6rpx;
}
.measure-ref {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff6df;
  border-radius: 16rpx;
  font-size: 23rpx;
  color: #806c2e;
  line-height: 1.6;
}
.form-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 32rpx;
}
.form-btn {
  flex: 1;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 32rpx;
  line-height: 96rpx;
}
.form-btn.solid {
  width: 670rpx;
  height: 104rpx;
  line-height: 104rpx;
  padding: 0;
  flex: none;
  background: #ffd95a;
  color: #29281f;
  text-align: center;
}
.form-actions.del {
  margin-top: 20rpx;
}
.form-btn.danger {
  width: 602rpx;
  height: 104rpx;
  line-height: 104rpx;
  padding: 0;
  flex: none;
  background: #fffdf7;
  color: #c14c2e;
  text-align: center;
}
