  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f3ead3;
}
/* 照片/视频宫格 */
.ftl-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-bottom: 4rpx;
}
.ftl-grid.one {
  grid-template-columns: 1fr;
}
.ftl-grid.two {
  grid-template-columns: repeat(2, 1fr);
}
.ftl-grid.four {
  grid-template-columns: repeat(2, 1fr);
}
.ftl-cell {
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}
.ftl-cell-img {
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  display: block;
}
.ftl-grid.one .ftl-cell-img {
  aspect-ratio: 1 / 1;
}
.ftl-cell-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
