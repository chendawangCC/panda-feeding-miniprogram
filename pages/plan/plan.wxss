.voice-actions { display: flex; flex-direction: column; gap: 12rpx; margin-top: 16rpx; width: 100%; }
.voice-fallback { margin-top: 16rpx; font-size: 24rpx; color: #c14c2e; text-align: center; }

/* 旧样式保留兼容 */
/* ==================== 语音记录弹窗（设计稿：居中卡片 + 按住说话） ==================== */
.voice-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 16rpx;
}
.voice-mic-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #fff2b9;
  border: 8rpx solid #ffd95a;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(255, 217, 90, 0.35);
  transition: all 0.2s;
}
.voice-mic-wrap.on {
  background: #ffe9b3;
  border-color: #f6b94e;
}
.voice-mic {
  font-size: 88rpx;
  line-height: 1;
  color: #b97b05;
}
.voice-mic-wrap.on .voice-mic {
  animation: voice-bob 0.8s ease-in-out infinite;
}
.voice-waves {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 40rpx;
  margin-top: -4rpx;
  margin-bottom: 12rpx;
}
.wave-bar {
  width: 8rpx;
  height: 14rpx;
  border-radius: 6rpx;
  background: #ffd95a;
  animation: wave-bounce 0.9s ease-in-out infinite;
}
.wave-bar:nth-child(1) { animation-delay: 0s; }
.wave-bar:nth-child(2) { animation-delay: 0.12s; }
.wave-bar:nth-child(3) { animation-delay: 0.24s; }
.wave-bar:nth-child(4) { animation-delay: 0.36s; }
.wave-bar:nth-child(5) { animation-delay: 0.48s; }
@keyframes wave-bounce {
  0%, 100% { height: 14rpx; }
  50% { height: 40rpx; }
}
@keyframes voice-bob {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}
