/* 顶部导航：状态栏44pt + 标题栏44pt = 顶部空出88pt */
.page-header {
  height: 88rpx;
  padding-top: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

/* ==================== 提醒状态 ==================== */
.reminder-on {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  background: #fff2b9;
  border-radius: 32rpx;
  padding: 32rpx;
}
.reminder-on-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}
.reminder-on-title {
  font-size: 28rpx;
  font-weight: 700;
}
.reminder-on-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #806c2e;
}

/* ==================== 快速新增 + ==================== */
.quick-add-wrap {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
}
.quick-add {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background: #ffd95a;
  border: 12rpx solid #fffdf7;
  box-shadow: 0 12rpx 40rpx rgba(209, 173, 52, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  font-weight: 200;
  color: #29281f;
  line-height: 1;
}

/* ==================== 日期切换 ==================== */
.date-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  background: transparent;
  border: none;
  box-shadow: none;
}
.date-row.no-card {
  background: transparent;
  border: none;
  box-shadow: none;
}
.date-nav {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #f3f0e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #29281f;
  flex-shrink: 0;
}
.date-selector {
  flex: 1;
  display: flex;
  justify-content: space-around;
  padding: 0 8rpx;
}
.date-item {
  width: 88rpx;
  border-radius: 24rpx;
  padding: 16rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
}
.date-item.on {
  background: #ffd95a;
  box-shadow: 0 4rpx 12rpx rgba(209, 173, 52, 0.3);
}
/* 展开日历：无喂养记录的日期加暗色底（选中/今天状态优先） */
.mc-day.no-record:not(.sel):not(.today) {
  background: rgba(0, 0, 0, 0.04);
  color: #b8b29a;
}
.date-week {
  font-size: 20rpx;
  color: #8f896d;
}
.date-num {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.date-item.on .date-week { color: #765d18; }
.date-item.on .date-num { color: #765d18; }

/* ==================== 月历工具条 ==================== */
.cal-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.cal-toggle {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #b97b05;
}
.cal-toggle-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}
.cal-today {
  background: #fff2b9;
  color: #806c2e;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 8rpx 20rpx;
}

/* ==================== 整月日历 ==================== */
.month-calendar {
  margin-top: 24rpx;
  padding: 24rpx;
}
.mc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mc-nav {
  display: flex;
  align-items: center;
}
.mc-nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #8f896d;
  border-radius: 12rpx;
  background: #f7f2e4;
  margin: 0 6rpx;
}
.mc-title {
  font-size: 26rpx;
  font-weight: 700;
  margin: 0 12rpx;
  min-width: 176rpx;
  text-align: center;
}
.mc-hint {
  font-size: 20rpx;
  color: #8f896d;
}
.mc-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 24rpx;
  text-align: center;
  font-size: 20rpx;
  color: #8f896d;
}
.mc-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 16rpx;
}
.mc-day {
  position: relative;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #4f4b3b;
}
.mc-vax-dot {
  position: absolute;
  top: 6rpx;
  right: 18rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #e0544f;
}
.mc-day.sel {
  background: #ffd95a;
  color: #765d18;
  box-shadow: 0 4rpx 12rpx rgba(209, 173, 52, 0.3);
}
.mc-day.today {
  background: #fff2b9;
  color: #b97b05;
}
.mc-day.future {
  color: #d8d2c0;
}

.selected-label {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #806c2e;
}

/* ==================== 时间线 ==================== */
.timeline {
  margin-top: 48rpx;
  margin-left: 32rpx;
  padding-left: 48rpx;
}

/* 时间轴标题栏 + 数据图表入口（右上角） */
.timeline-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-left: -80rpx; /* 抵消 .timeline 的 margin+padding，标题对齐页面左边缘 */
  margin-bottom: 8rpx;
}
.tl-head-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #29281f;
}
.tl-head-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffd95a;
  border-radius: 20rpx;
  padding: 12rpx;
}
.tl-head-stats-ico {
  width: 48rpx;
  height: 48rpx;
}
.tl-head-stats-txt {
  font-size: 24rpx;
  font-weight: 700;
  color: #806c2e;
}
.tl-item {
  position: relative;
  margin-bottom: 40rpx;
}
/* 点对点连接：从当前记录点中心连到下一个记录点中心（仅 ≥2 条记录时出现，最后一项不画线） */
.tl-item::after {
  content: '';
  position: absolute;
  left: -60rpx;
  top: 24rpx;
  bottom: -64rpx;
  border-left: 4rpx dashed #eadca6;
  z-index: 0;
}
.tl-item.tl-last::after {
  display: none;
}
.tl-dot {
  position: absolute;
  left: -74rpx;
  top: 8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 8rpx solid #fffdf7;
  z-index: 2;
}
/* 上次间隔/已过去：卡片右上角灰字（设计稿样式） */
.tl-prev {
  font-size: 20rpx;
  color: #8f896d;
  flex-shrink: 0;
  margin-left: 16rpx;
  white-space: nowrap;
}
.tl-prev-latest {
  color: #d9a417;
  font-weight: 700;
}
/* 时间轴左侧时间（设计稿：深色粗体，时间点在卡片左上方） */
.tl-time {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #6a6546;
}
.tl-time-hot {
  color: #b97b05;
}
.tl-card {
  margin-top: 16rpx;
  border: 2rpx solid;
  border-radius: 32rpx;
  padding: 32rpx;
}
.tl-card-simple {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}
.tl-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tl-card-title {
  display: flex;
  align-items: center;
}
.tl-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 16rpx;
}
.tl-name {
  font-size: 28rpx;
  font-weight: 700;
}
.tl-name-col {
  display: flex;
  flex-direction: column;
}
.tl-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #587396;
}
.tl-note {
  font-size: 24rpx;
  color: #8f896d;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.tl-tag {
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.tl-record {
  margin-top: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #159f99;
}
.tl-record-inline {
  font-size: 20rpx;
  font-weight: 700;
  color: #159f99;
  flex-shrink: 0;
  margin-left: 16rpx;
}
/* 记录卡片右上角「编辑 ›」提示 */
.tl-edit-hint {
  font-size: 20rpx;
  color: #587396;
  flex-shrink: 0;
  margin-left: 16rpx;
}
/* 简单横条卡右侧（tag + 已过去时间竖排） */
.tl-simple-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.tl-simple-right .tl-prev {
  margin-left: 0;
  margin-top: 6rpx;
}
/* 时间轴空状态 */
.tl-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: -80rpx; /* 抵消 .timeline 左偏移，使空状态整体左右居中 */
  padding: 120rpx 60rpx 140rpx;
}
.tl-empty-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 40rpx;
  background: #fff7e6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 28rpx;
}
.tl-empty-img {
  width: 64rpx;
  height: 64rpx;
}
.tl-empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4a4a46;
  margin-bottom: 14rpx;
}
.tl-empty-sub {
  font-size: 24rpx;
  color: #a49d86;
  text-align: center;
}
.tl-value {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #b97b05;
}

/* 亲喂记录列表（多条可切换查看） */
.nursing-records {
  display: flex;
  margin-top: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}
.nursing-records::-webkit-scrollbar { display: none; }
.nr-item {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(244, 179, 70, 0.35);
  border-radius: 20rpx;
  padding: 12rpx 22rpx;
  margin-right: 14rpx;
}
.nr-item.on {
  background: #fff6dd;
  border-color: #f4b346;
}
.nr-time {
  font-size: 24rpx;
  font-weight: 700;
  color: #b97b05;
  margin-right: 12rpx;
}
.nr-total {
  font-size: 20rpx;
  color: #8f896d;
}

/* 三列指标 */
.metrics-3 {
  display: flex;
  margin-top: 24rpx;
}
.metric {
  flex: 1;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  padding: 16rpx;
  text-align: center;
  margin-right: 16rpx;
}
.metric:last-child { margin-right: 0; }
.metric-label {
  display: block;
  font-size: 20rpx;
  color: #8f896d;
}
.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

/* 换尿布字段 */
.diaper-fields {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.diaper-field {
  width: 48%;
  margin-right: 4%;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
}
.diaper-field:nth-child(2n) { margin-right: 0; }
.df-label {
  font-size: 20rpx;
  color: #765d18;
}
.df-value {
  margin-left: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #765d18;
}

/* ==================== 通用弹窗 ==================== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fffdf7;
  border-radius: 56rpx 56rpx 0 0;
  padding: 24rpx 40rpx 40rpx;
  box-sizing: border-box;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 10000;
}
.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e8e1d0;
  margin: 0 auto 40rpx;
}
.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.sheet-kicker {
  display: block;
  font-size: 24rpx;
  color: #8f896d;
}
.sheet-title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 900;
}
.sheet-close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f3f0e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #29281f;
}
.sheet-body {
  height: 60vh;
  margin-top: 32rpx;
}

/* ==================== 宝宝切换 ==================== */
.baby-switch-body {
  margin-top: 32rpx;
}
.baby-switch-item {
  display: flex;
  align-items: center;
  background: #fff;
  border: 2rpx solid #f0e6cf;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}
.baby-switch-item.on {
  border-color: #f0c46a;
  background: #fffaf0;
}
.baby-switch-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.baby-switch-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  display: block;
}
/* 默认熊猫 logo：不裁切，等比完整显示 */
.baby-switch-avatar-img.baby-avatar-logo {
  width: 76rpx;
  height: 76rpx;
}
.baby-switch-meta {
  flex: 1;
}
.baby-switch-name-row {
  display: flex;
  align-items: center;
}
.baby-switch-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #29281f;
}
.baby-switch-tag {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #b97b05;
  background: #fff2b9;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.baby-switch-age {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8f896d;
}
.baby-switch-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #ffd95a;
  color: #765d18;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
}
.baby-switch-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d9d0ba;
  border-radius: 32rpx;
  padding: 28rpx;
  color: #8f896d;
}
.baby-switch-add-icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  color: #b97b05;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}
.baby-switch-add-text {
  font-size: 28rpx;
  font-weight: 700;
}

/* ==================== 快速新增 ==================== */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 32rpx;
}
.quick-item {
  width: 48%;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.quick-yellow { background: #fff2b9; }
.quick-blue { background: #e6edff; }
.quick-orange { background: #fff1df; }
.quick-green { background: #e8f4e4; }
.quick-purple { background: #eee9ff; }
.quick-emoji {
  font-size: 40rpx;
}
.quick-name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.quick-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #806c2e;
}
.quick-blue .quick-sub { color: #587396; }
.quick-orange .quick-sub { color: #a96017; }
.quick-green .quick-sub { color: #478163; }
.quick-purple .quick-sub { color: #6657bf; }

/* ==================== 记录弹窗 ==================== */
.record-summary {
  display: flex;
  align-items: center;
  background: #fff2b9;
  border-radius: 32rpx;
  padding: 24rpx 32rpx;
}
.rs-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
}
.rs-type {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}
.rs-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #806c2e;
}
/* 记录时间（摘要右侧，可点选修改） */
.rs-time {
  margin-left: auto;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.rs-time-label {
  font-size: 20rpx;
  color: #806c2e;
  margin-bottom: 4rpx;
}
.rs-time-box {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #29281f;
}

.sec {
  margin-top: 40rpx;
}
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sec-label {
  font-size: 24rpx;
  font-weight: 700;
}
.sec-hint {
  font-size: 20rpx;
  color: #8f896d;
}
.chip {
  background: #fff2b9;
  color: #806c2e;
  font-size: 20rpx;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}
.chip-orange { background: #fff1df; color: #a96017; }
.chip-purple { background: #eee9ff; color: #6657bf; }
.chip-strong {
  font-weight: 700;
}

/* 瓶喂 */
.milk-tabs {
  display: flex;
  background: #f3f0e7;
  border-radius: 32rpx;
  padding: 8rpx;
}
.milk-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #8f896d;
  border-radius: 24rpx;
}
.milk-tab.on {
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  color: #29281f;
}
.stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}
.stepper-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f3f0e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 900;
}
.stepper-btn-on {
  background: #ffd95a;
}
.stepper-num {
  margin: 0 48rpx;
  text-align: center;
}
.stepper-val {
  font-size: 60rpx;
  font-weight: 900;
}
.stepper-unit {
  font-size: 24rpx;
  color: #8f896d;
  margin-left: 8rpx;
}
.slider {
  margin-top: 40rpx;
}

