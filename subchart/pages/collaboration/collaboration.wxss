/* ==================== 分享二维码 ==================== */
.invite-card {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  background: #ffd95a;
  border-radius: 44rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(209, 173, 52, 0.2);
}
.invite-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #8b6508;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.invite-ico {
  width: 55rpx;
  height: 55rpx;
  display: block;
}
.invite-info {
  flex: 1;
  min-width: 0;
}
.invite-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}
.invite-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #806c2e;
}
.invite-arrow {
  font-size: 40rpx;
  color: #8b6508;
}

/* ==================== 亲友列表 ==================== */
.family-count {
  flex-shrink: 0;
  background: #fff2b9;
  color: #806c2e;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 50rpx;
  padding: 8rpx 20rpx;
}
.family-list {
  margin-top: 24rpx;
}
.family-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(117, 101, 43, 0.04);
}
.family-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.family-avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  display: block;
}
.family-avatar-default {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.family-avatar-logo {
  width: 100%;
  height: 100%;
}
.family-info {
  flex: 1;
  min-width: 0;
}
.family-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}
.family-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8f896d;
}
.family-edit {
  background: #fff9e7;
  color: #b97b05;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

.family-empty {
  margin-top: 24rpx;
  padding: 40rpx 24rpx;
  background: #fffdf7;
  border: 2rpx dashed #e6dfc8;
  border-radius: 24rpx;
  text-align: center;
}
.family-empty-text {
  font-size: 24rpx;
  color: #a49d86;
  line-height: 1.6;
}

/* 邀请亲友二维码弹窗（设计稿） */
.invite-pop {
  padding: 40rpx 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ip-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #4f4b3b;
}
.ip-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a89f7e;
}
.ip-qr-wrap {
  margin-top: 28rpx;
  background: #fff7dc;
  border-radius: 24rpx;
  padding: 28rpx;
}
.ip-qr {
  width: 240px;
  height: 240px;
  border-radius: 12rpx;
}
.ip-family {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #4f4b3b;
}
.ip-expire {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b8b28f;
}
.ip-share {
  margin: 32rpx auto 0;
  width: 476rpx;
  height: 98rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffe27a, #f6c84f);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #6a4a00;
  border: none;
  line-height: 98rpx;
}
.ip-share::after {
  border: none;
}

/* ============ 云端家庭 ============ */
.cloud-tip {
  margin: 48rpx 32rpx;
  padding: 48rpx 36rpx;
  background: #FBF8EE;
  border: 2rpx dashed #d8cdab;
  border-radius: 24rpx;
  text-align: center;
}
.cloud-tip-title { font-size: 32rpx; font-weight: 800; color: #8a6d1f; display: block; }
.cloud-tip-desc { font-size: 26rpx; color: #8a8675; line-height: 1.7; margin-top: 16rpx; display: block; }

.create-card {
  margin: 48rpx 32rpx;
  padding: 64rpx 40rpx 48rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(41,40,31,0.06);
  text-align: center;
}
.create-icon { font-size: 88rpx; }
.create-icon-img { width: 88rpx; height: 88rpx; }
.create-title { font-size: 34rpx; font-weight: 800; color: #29281F; margin-top: 24rpx; }
.create-desc { font-size: 26rpx; color: #8a8675; line-height: 1.7; margin: 20rpx 0 36rpx; }
.create-btn {
  background: #FFD95A;
  color: #29281F;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 44rpx;
  padding: 22rpx 0;
}
.create-btn::after { border: none; }

.family-head {
  margin: 24rpx 32rpx 8rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.family-head { display: flex; justify-content: space-between; align-items: flex-start; }
.family-head-left { display: flex; flex-direction: column; }
.family-name { display: flex; align-items: center; white-space: nowrap; }
.family-name-text { font-size: 40rpx; font-weight: 900; color: #29281F; }
.family-edit-icon { width: 32rpx; height: 32rpx; margin-left: 8rpx; opacity: 0.6; }
.family-no { font-size: 22rpx; color: #B8860B; background: #FFF3D6; padding: 4rpx 16rpx; border-radius: 20rpx; margin-top: 8rpx; display: inline-block; align-self: flex-start; }
.family-owner { font-size: 26rpx; color: #999; white-space: nowrap; margin-top: 8rpx; }
.cancel-apply-btn { margin-top: 24rpx; padding: 16rpx 48rpx; background: #FFE4E4; color: #E74C3C; border-radius: 40rpx; font-size: 28rpx; text-align: center; align-self: center; }

/* 家庭权限说明 */
.perm-note { display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx 24rpx; background: #FFF8E7; border-radius: 16rpx; }
.perm-note text { font-size: 26rpx; color: #8B6914; line-height: 1.5; }
.perm-note-sub { font-size: 24rpx; color: #B8941F !important; }

/* 权限级别大按钮 */
.perm-seg-large { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.perm-seg-large .perm-seg-item { flex: 1; padding: 24rpx; text-align: center; font-size: 30rpx; border-radius: 16rpx; }
.perm-seg-large .on-view { background: #E8F4FD; color: #2196F3; font-weight: 600; }
.perm-seg-large .on-edit { background: #E8F8E8; color: #4CAF50; font-weight: 600; }

/* 权限说明文字 */
.perm-access-desc { padding: 16rpx 20rpx; background: #F8F9FA; border-radius: 12rpx; }
.perm-access-desc text { font-size: 26rpx; color: #666; line-height: 1.6; }
.family-owner { font-size: 24rpx; color: #a8a38c; }

.push-card {
  margin: 20rpx 32rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(41,40,31,0.05);
  display: flex;
  align-items: center;
}
.push-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.push-ico {
  width: 44rpx;
  height: 44rpx;
  display: block;
}
.push-info { flex: 1; }
.push-title { font-size: 30rpx; font-weight: 800; color: #29281F; display: block; }
.push-sub { font-size: 23rpx; color: #8a8675; margin-top: 6rpx; display: block; line-height: 1.6; }
.push-state { font-size: 26rpx; color: #8a6d1f; font-weight: 700; }

.role-tag {
  font-size: 20rpx;
  background: #FFD95A;
  color: #8a6d1f;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
}

.leave-btn {
  margin: 40rpx 32rpx 24rpx;
  text-align: center;
  padding: 24rpx 0;
  color: #c0392b;
  font-size: 28rpx;
  font-weight: 600;
  background: #FDF3F1;
  border-radius: 20rpx;
  border: 2rpx solid #f0c8c0;
}

.sync-tip {
  text-align: center;
  font-size: 22rpx;
  color: #a8a38c;
  padding: 16rpx 0 32rpx;
}

/* 创建家庭弹窗 */
.create-pop { padding: 8rpx 8rpx 8rpx; }
.cp-title { font-size: 34rpx; font-weight: 800; color: #29281F; display: block; text-align: center; margin-bottom: 32rpx; }
.cp-input {
  background: #F6F3E8;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}
.cp-btn {
  background: #FFD95A;
  color: #29281F;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 44rpx;
  padding: 20rpx 0;
}
.cp-btn::after { border: none; }

/* 待审核成员 */
.pending-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  background: #fff1f0;
  color: #e0562f;
  font-size: 20rpx;
  border-radius: 8rpx;
}
.family-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.fam-act {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}
.fam-act.approve {
  background: #ffd95a;
  color: #4a3a00;
  font-weight: 700;
}
.fam-act.reject {
  background: #f6f3eb;
  color: #8f896d;
}

/* ==================== 成员权限设置抽屉 ==================== */
.perm-pop {
  display: flex;
  flex-direction: column;
  max-height: 78vh;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
}
.perm-head {
  flex-shrink: 0;
  text-align: center;
  margin-bottom: 24rpx;
}
.perm-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #29281F;
}
.perm-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a8a38c;
}
.perm-body {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}
.perm-group {
  background: #FBF8EE;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.perm-group-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #8a6d1f;
  margin-bottom: 16rpx;
}
.perm-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 2rpx dashed #ece5d0;
}
.perm-row:last-child { border-bottom: none; }
.perm-row-label {
  font-size: 26rpx;
  color: #4f4b3b;
  font-weight: 600;
}
.perm-seg {
  display: flex;
  background: #f0ead8;
  border-radius: 14rpx;
  overflow: hidden;
}
.perm-seg-item {
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  color: #8f896d;
  transition: all 0.15s;
}
.perm-seg-item.on-none { background: #f6f3eb; color: #c0392b; font-weight: 700; }
.perm-seg-item.on-view { background: #fff2b9; color: #8a6d1f; font-weight: 700; }
.perm-seg-item.on-edit { background: #FFD95A; color: #4a3a00; font-weight: 700; }
.perm-baby-all {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.perm-baby-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}
.perm-baby-item {
  padding: 12rpx 28rpx;
  background: #fff;
  border: 2rpx solid #e6dfc8;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #4f4b3b;
}
.perm-baby-item.sel {
  background: #FFD95A;
  border-color: #FFD95A;
  color: #4a3a00;
  font-weight: 700;
}
.perm-baby-empty {
  font-size: 22rpx;
  color: #a8a38c;
  padding: 12rpx 0;
}
.perm-footer {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.perm-save {
  flex: 1;
  height: 104rpx;
  border-radius: 104rpx;
  background: #FFD95A;
  color: #29281F;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.perm-cancel {
  flex: 1;
  height: 104rpx;
  border-radius: 104rpx;
  background: #F6F3E8;
  color: #8f896d;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hover-dim { opacity: 0.8; }

/* ==================== 多家庭切换条 ==================== */
.fam-switch-bar {
  margin: 20rpx 24rpx 0;
}
.fam-switch-scroll {
  width: 100%;
  white-space: nowrap;
}
.fam-switch-inner {
  display: inline-flex;
  align-items: center;
  padding: 6rpx;
}
.fam-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #fffdf7;
  border: 2rpx solid #f0e9d8;
}
.fam-chip.on {
  background: #ffd95a;
  border-color: #ffd95a;
}
.fam-chip-name {
  font-size: 26rpx;
  color: #1c2b1c;
  font-weight: 600;
}
.fam-chip-tag {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #8a7f6a;
}
.fam-chip.on .fam-chip-tag {
  color: #6b5a1e;
}
.fam-chip-add {
  color: #c14c2e;
  border-style: dashed;
}

/* ==================== 加入家庭 ==================== */
.join-btn {
  margin: 24rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 28rpx;
  color: #c14c2e;
  background: #fffdf7;
  border: 2rpx solid #f0e9d8;
  border-radius: 16rpx;
  font-weight: 600;
}
.join-pop {
  padding: 32rpx 28rpx 24rpx;
}
.join-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1c2b1c;
  text-align: center;
}
.join-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8a7f6a;
  line-height: 1.6;
  text-align: center;
}
.join-input {
  margin-top: 28rpx;
  height: 88rpx;
  background: #fffdf7;
  border: 2rpx solid #f0e9d8;
  border-radius: 12rpx;
  text-align: center;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  color: #1c2b1c;
}
.join-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.join-save {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2b1c;
  background: #ffd95a;
  border-radius: 12rpx;
}
.join-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: #8a7f6a;
  background: #fffdf7;
  border: 2rpx solid #f0e9d8;
  border-radius: 12rpx;
}

/* ==================== 成员上限 ==================== */
.ip-count {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #c14c2e;
  text-align: center;
}

/* ==================== 家庭角色 ==================== */
.fam-role-tag {
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #8a5a00;
  background: #fff3c4;
}
.join-scan {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #c14c2e;
  background: #fffdf7;
  border: 2rpx dashed #f0c96a;
  border-radius: 12rpx;
  font-weight: 600;
}
.join-role {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  height: 84rpx;
  padding: 0 24rpx;
  background: #fffdf7;
  border: 2rpx solid #f0e9d8;
  border-radius: 12rpx;
}
.join-role-label {
  font-size: 28rpx;
  color: #1c2b1c;
  font-weight: 600;
}
.join-role-val {
  flex: 1;
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #8a7f6a;
  text-align: right;
}
.join-role-arrow {
  margin-left: 12rpx;
  font-size: 30rpx;
  color: #c9bfa8;
}
.perm-role {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 24rpx;
  background: #fffdf7;
  border: 2rpx solid #f0e9d8;
  border-radius: 12rpx;
}
.perm-role-label {
  font-size: 26rpx;
  color: #1c2b1c;
}
.perm-role-val {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #1c2b1c;
}
.perm-role-val.muted {
  color: #c9bfa8;
}
.perm-role-arrow {
  margin-left: 12rpx;
  font-size: 30rpx;
  color: #c9bfa8;
}

/* ==================== 家庭号 / 宝宝号 ==================== */
.family-no {
  display: inline-block;
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #8a5a00;
  background: #fff3c4;
  vertical-align: middle;
}
.invite-famno {
  margin-left: 8rpx;
  color: #c14c2e;
}

/* 创建家庭按钮：品牌黄底白字 */
.fam-chip-create {
  color: #fff;
  background: #ffd95a;
  border: none;
}
.fam-chip-create:active {
  opacity: 0.85;
}
/* 扫码加入按钮：浅橙底深橙字 */
.fam-chip-scan {
  color: #c14c2e;
  background: #fff2e8;
  border: 1rpx solid #f0c4b0;
}
.fam-chip-scan:active {
  opacity: 0.85;
}
.create-save {
  color: #fff;
}

/* 待审核状态 */
.pending-tip {
  padding: 32rpx;
}
.pending-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.pending-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}
.pending-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  margin-bottom: 32rpx;
}
.pending-status {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: #fff3c4;
  color: #c14c2e;
  border-radius: 32rpx;
  font-size: 26rpx;
}

/* ===== 扫码加入家庭弹窗（与我的页完全一致） ===== */
.scan-pop {
  padding: 40rpx 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.sp-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #4f4b3b;
}
.sp-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a89f7e;
}
.sp-frame {
  margin-top: 28rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 20rpx;
  background: #faf7ec;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sp-corner {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #d59f11;
}
.sp-tl { left: 20rpx; top: 20rpx; border-right: none; border-bottom: none; border-top-left-radius: 16rpx; }
.sp-tr { right: 20rpx; top: 20rpx; border-left: none; border-bottom: none; border-top-right-radius: 16rpx; }
.sp-bl { left: 20rpx; bottom: 20rpx; border-right: none; border-top: none; border-bottom-left-radius: 16rpx; }
.sp-br { right: 20rpx; bottom: 20rpx; border-left: none; border-top: none; border-bottom-right-radius: 16rpx; }
.sp-scan-line {
  position: absolute;
  left: 56rpx;
  right: 56rpx;
  top: 50%;
  height: 2rpx;
  background: rgba(213, 159, 17, 0.35);
}
.sp-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8f896d;
  text-align: center;
  line-height: 1.6;
  padding: 0 20rpx;
}
.sp-btn {
  margin: 32rpx auto 0;
  width: 476rpx;
  height: 98rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffe27a, #f6c84f);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #6a4a00;
}
.sp-family {
  margin: 24rpx 0 8rpx;
  padding: 24rpx;
  background: #fff6df;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #806c2e;
