<view class="page-no-tab">
  <view class="status-bar" style="height:{{safeTop}}px"></view>

  <!-- 页头 -->
  <view class="page-header-back">
    <view class="back-btn" bindtap="goBack">‹</view>
    <view class="page-header-left">
      <text class="header-kicker">{{lang === 'en' ? 'Here to help you' : '为你提供使用帮助'}}</text>
      <view class="header-title">{{lang === 'en' ? 'Help Center' : '客服中心'}}</view>
    </view>
  </view>

  <!-- 在线客服 -->
  <view class="svc-hero">
    <view class="svc-hero-icon">
      <image class="svc-hero-logo" src="/images/brand-logo.png" mode="aspectFit" />
    </view>
    <view class="svc-hero-title">{{lang === 'en' ? 'Need help? We’re here for you' : '需要帮助？我们在线等你'}}</view>
    <view class="svc-hero-desc">{{lang === 'en' ? 'Online 9:00 – 21:00 on weekdays; messages left after hours get a reply the next day' : '工作日 9:00 – 21:00 在线，其他时间留言会在次日回复'}}</view>
    <button class="svc-contact-btn" open-type="contact" show-message-card="true" send-message-title="熊宝喂养使用咨询" send-message-path="pages/index/index" send-message-img="/images/brand-logo.png">
      {{lang === 'en' ? 'Chat with us' : '联系在线客服'}}
    </button>
  </view>

  <!-- 常见问题 -->
  <view class="sec">
    <view class="sec-title">{{lang === 'en' ? 'FAQ' : '常见问题'}}</view>
    <view class="faq-group">
      <view class="faq-item" wx:for="{{faqs}}" wx:key="q" data-index="{{index}}" bindtap="toggleFaq">
        <view class="faq-q">
          <text class="faq-q-text">{{item.q}}</text>
          <text class="faq-arrow {{item.open ? 'open' : ''}}">›</text>
        </view>
        <view class="faq-a" wx:if="{{item.open}}"><text user-select>{{item.a}}</text></view>
      </view>
    </view>
  </view>

  <!-- 意见反馈 -->
  <view class="sec">
    <view class="sec-title">{{lang === 'en' ? 'Feedback' : '意见反馈'}}</view>
    <view class="fb-card">
      <view class="fb-row">
        <text class="fb-label">{{lang === 'en' ? 'Type' : '反馈类型'}}</text>
        <picker mode="selector" range="{{fbTypes}}" value="{{fbTypeIdx}}" bindchange="onFbType">
          <view class="fb-picker">{{fbTypes[fbTypeIdx]}} ›</view>
        </picker>
      </view>
      <textarea class="fb-textarea" value="{{fbText}}" bindinput="onFbInput" maxlength="500" placeholder="{{lang === 'en' ? 'Describe the problem or suggestion (max 500 characters)' : '请描述你遇到的问题或建议（最多 500 字）'}}" placeholder-class="fb-ph" cursor-spacing="20" />
      <view class="fb-contact-row">
        <text class="fb-label">{{lang === 'en' ? 'Contact (optional)' : '联系方式（选填）'}}</text>
        <input class="fb-contact" value="{{fbContact}}" bindinput="onFbContact" placeholder="{{lang === 'en' ? 'WeChat ID / phone so we can reply' : '微信号 / 手机号，便于我们回复你'}}" placeholder-class="fb-ph" />
      </view>
      <view class="fb-submit {{fbText.trim() ? '' : 'disabled'}}" bindtap="submitFeedback">{{lang === 'en' ? 'Submit' : '提交反馈'}}</view>
    </view>
  </view>

  <view class="svc-foot">{{lang === 'en' ? 'Panda Feeding · Every little milestone, thoughtfully recorded' : '熊宝喂养 · 用心记录每一刻成长'}}</view>
</view>
