.page-no-tab {
  padding: 0 32rpx calc(80rpx + env(safe-area-inset-bottom));
  background: #fffdf7;
  min-height: 100vh;
}
.page-header-back {
  height: 88rpx;
  display: flex;
  align-items: center;
  position: relative;
}
/* back-btn 使用全局标准样式（72rpx 米灰圆角） */
.page-header-left {
  display: flex;
  flex-direction: column;
  margin-left: 8rpx;
}
.header-kicker {
  font-size: 22rpx;
  color: #a89f82;
}
.header-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #29281f;
  line-height: 1.3;
}

/* 在线客服区 */
.svc-hero {
  margin-top: 20rpx;
  background: #ffd95a;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.svc-hero-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
  background: #fffdf7;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.svc-hero-logo {
  width: 96rpx;
  height: 96rpx;
}
.svc-hero-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #29281f;
}
.svc-hero-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a7430;
}
.svc-contact-btn {
  margin-top: 32rpx;
  width: 440rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: #29281f;
  color: #ffd95a;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 48rpx;
  padding: 0;
}
.svc-contact-btn::after {
  border: none;
}

/* FAQ */
.sec {
  margin-top: 40rpx;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #4a432b;
  margin-bottom: 20rpx;
}
.faq-group {
  background: #ffffff;
  border: 2rpx solid #f0e9d8;
  border-radius: 20rpx;
  overflow: hidden;
}
.faq-item {
  border-bottom: 2rpx solid #f5f0e2;
}
.faq-item:last-child {
  border-bottom: none;
}
.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
}
.faq-q-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #29281f;
}
.faq-arrow {
  margin-left: 20rpx;
  font-size: 32rpx;
  color: #b0a98e;
  transition: transform 0.2s;
}
.faq-arrow.open {
  transform: rotate(90deg);
}
.faq-a {
  padding: 0 28rpx 30rpx;
  font-size: 26rpx;
  color: #6a6546;
  line-height: 1.7;
}

/* 意见反馈 */
.fb-card {
  background: #ffffff;
  border: 2rpx solid #f0e9d8;
  border-radius: 20rpx;
  padding: 28rpx;
}
.fb-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fb-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #29281f;
}
.fb-picker {
  font-size: 28rpx;
  color: #b97b05;
  font-weight: 700;
}
.fb-textarea {
  margin-top: 24rpx;
  width: 100%;
  height: 220rpx;
  box-sizing: border-box;
  background: #fffdf7;
  border: 2rpx solid #f0e9d8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.fb-ph {
  color: #b0a98e;
}
.fb-contact-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fb-contact {
  width: 380rpx;
  height: 72rpx;
  background: #fffdf7;
  border: 2rpx solid #f0e9d8;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}
.fb-submit {
  margin-top: 32rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  background: #ffd95a;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #29281f;
}
.fb-submit.disabled {
  background: #f2efe4;
  color: #b0a98e;
}

.svc-foot {
  margin-top: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0a98e;
}
