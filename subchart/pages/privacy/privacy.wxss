/* ==================== 页头 ==================== */
.page-header-back {
  display: flex;
  align-items: center;
  height: 88rpx; /* 44pt 标题栏 */
  padding: 0 32rpx;
  box-sizing: border-box;
}
/* back-btn 使用全局标准样式（72rpx 米灰圆角） */
.page-header-left {
  flex: 1;
}
.header-kicker {
  display: block;
  font-size: 22rpx;
  color: #8f896d;
}
.header-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #29281f;
  margin-top: 4rpx;
}

/* ==================== 分区 ==================== */
.sec {
  padding: 24rpx 32rpx 8rpx;
}
.sec-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #8f896d;
  margin: 8rpx 8rpx 16rpx;
}
.group {
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(169, 143, 87, 0.06);
}
.row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f6f1e3;
}
.row:last-child {
  border-bottom: none;
}
.row-icon-img { width: 40rpx; height: 40rpx; border-radius: 8rpx; }
.row-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #fff;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #f0e9d8;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.row-info {
  flex: 1;
  min-width: 0;
}
.row-name {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #29281f;
}
.row-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a49d86;
  line-height: 1.4;
}
.row-state {
  font-size: 22rpx;
  margin-right: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #f3f0e7;
  color: #8f896d;
}
.row-state.ok {
  background: #fff7e6;
  color: #765d18;
}
.row-state.deny {
  background: #fdeaea;
  color: #c14c2e;
}
/* 未授权时的“去授权 / 去设置”按钮 */
.row-arrow {
  flex-shrink: 0;
  margin-left: 4rpx;
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  color: #8a6100;
  background: #fff3d1;
  border: 2rpx solid #f0d089;
  border-radius: 999rpx;
}
.row-arrow.deny {
  color: #c14c2e;
  background: #fdeaea;
  border-color: #f3c7bd;
}
.sec-tip {
  margin: 16rpx 12rpx 8rpx;
  font-size: 22rpx;
  color: #a49d86;
  line-height: 1.6;
}
.sec-tip.warn {
  color: #c14c2e;
}

.row-logo { width: 60rpx; height: 60rpx; }


/* 注销账号按钮 */
.del-account {
  margin: 32rpx 0 0;
  background: #fff;
  border: 2rpx solid #f0e9d8;
  border-radius: 32rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #c14c2e;
}
