/* pages/family/family.wxss - 品牌色：米白 FFFDF7 / 明黄 FFD95A / 深墨 29281F */
.page-no-tab {
  padding-bottom: 220rpx;
}

/* 顶部横幅 */
.family-hero {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFD95A 0%, #ffe994 100%);
  border-radius: 28rpx;
  padding: 36rpx 34rpx;
  margin-bottom: 36rpx;
}
.family-hero-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  margin-right: 26rpx;
  flex-shrink: 0;
}
.family-hero-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #29281F;
}
.family-hero-sub {
  font-size: 24rpx;
  color: #29281f;
  margin-top: 10rpx;
  opacity: 0.85;
}

/* 分区标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #29281F;
  margin: 8rpx 8rpx 20rpx;
}
.video-title {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
}
.video-title-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #8a6a00;
  background: #fff9e7;
  border: 2rpx solid #FFD95A;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  margin-left: 14rpx;
}

/* 技能卡片 */
.skill-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(41,40,31,0.05);
}
.skill-card:active { transform: scale(0.98); }
.skill-icon {
  width: 84rpx;
  height: 84rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.skill-info { flex: 1; min-width: 0; }
.skill-name { font-size: 31rpx; font-weight: 700; color: #29281F; }
.skill-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8f896d;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.skill-arrow { color: #e8e1d0; font-size: 44rpx; margin-left: 12rpx; }

/* 教学视频卡片 */
.video-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(41,40,31,0.05);
}
.video-player {
  width: 100%;
  height: 400rpx;
  background: #29281F;
}
.video-body { padding: 24rpx 26rpx 28rpx; }
.video-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.video-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #29281F;
  flex: 1;
  margin-right: 16rpx;
}
.video-type {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}
.video-type.ji { background: #FFE3DC; color: #B3272E; }
.video-type.hu { background: #fff9e7; color: #8a6a00; }
.video-type.kan { background: #fff7e6; color: #765d18; }
.video-meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  flex-wrap: wrap;
}
.role-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-right: 14rpx;
}
.role-doctor { background: #FFD95A; color: #29281F; }
.role-nurse { background: #fff7e6; color: #765d18; }
.role-user { background: #eee7d6; color: #8f896d; }
.video-author { font-size: 23rpx; color: #8f896d; margin-right: 14rpx; }
.video-time { font-size: 21rpx; color: #8f896d; }
.video-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8f896d;
  line-height: 1.6;
}
.video-license {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #8f896d;
}

/* 空态 */
.video-empty {
  text-align: center;
  padding: 60rpx 0;
  background: #fff;
  border-radius: 24rpx;
  border: 2rpx dashed #eee7d6;
}
.video-empty-icon { font-size: 56rpx; }
.video-empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #8f896d;
  margin-top: 14rpx;
}
.video-empty-desc {
  font-size: 23rpx;
  color: #8f896d;
  margin-top: 8rpx;
  padding: 0 40rpx;
  line-height: 1.6;
}

/* 录制引导卡 */
.record-guide {
  display: flex;
  align-items: center;
  background: #29281F;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  margin-top: 36rpx;
}
.record-guide-icon { font-size: 52rpx; margin-right: 22rpx; }
.record-guide-info { flex: 1; min-width: 0; }
.record-guide-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #FFD95A;
}
.record-guide-desc {
  font-size: 22rpx;
  color: #e8e1d0;
  line-height: 1.6;
  margin-top: 8rpx;
}

/* 免责 */
.disclaimer {
  font-size: 22rpx;
  color: #8f896d;
  line-height: 1.7;
  padding: 24rpx 12rpx 8rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255,253,247,0.95);
  box-shadow: 0 -4rpx 16rpx rgba(41,40,31,0.05);
}
.btn-record {
  background: #FFD95A;
  color: #29281F;
  border: none;
  border-radius: 20rpx;
  height: 100rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 100rpx;
}
