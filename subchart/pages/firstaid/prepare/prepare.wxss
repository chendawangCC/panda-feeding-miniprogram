/* pages/prepare/prepare.wxss - 品牌色：米白 FFFDF7 / 明黄 FFD95A / 深墨 29281F */
.page-no-tab {
  padding-bottom: 200rpx;
}

/* 技能头部 */
.skill-head {
  text-align: center;
  padding: 40rpx 20rpx 32rpx;
}
.skill-icon {
  line-height: 1.4;
}
.skill-title {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #29281F;
}
.skill-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8f896d;
  line-height: 1.6;
  padding: 0 24rpx;
}

/* 真人教学指导视频 */
.video-section {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(41,40,31,0.05);
}
.video-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.video-head-icon { font-size: 32rpx; margin-right: 12rpx; }
.video-head-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #29281F;
  flex: 1;
}
.video-head-badge {
  background: #FFD95A;
  color: #29281F;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.video-player {
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #29281F;
}
.video-ops {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.video-op {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: #fff9e7;
  border: 2rpx solid #eee7d6;
  color: #8f896d;
  font-size: 26rpx;
  font-weight: 600;
}
.video-op-danger {
  color: #c0392b;
  border-color: #f0c8c0;
  background: #FDF3F1;
}
.video-empty {
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}
.video-empty-btn {
  width: 100%;
  height: 380rpx; /* 与视频播放器同尺寸 */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  border: 2rpx dashed #d8cdab;
  background: #fff9e7;
  color: #8a6d1f;
  font-size: 30rpx;
  font-weight: 700;
}
.video-empty-tip {
  text-align: center;
  font-size: 23rpx;
  color: #a8a38c;
  margin-top: 14rpx;
}

/* 卡片区块 */
.section {
  margin-bottom: 24rpx;
}
.check-item {
  font-size: 28rpx;
  color: #44423a;
  line-height: 1.8;
  padding: 8rpx 0;
}
.point-item {
  font-size: 28rpx;
  color: #44423a;
  line-height: 1.7;
  padding: 8rpx 0;
}

/* 开始时间提示卡 */
.start-card {
  background: #FFFDF7;
  border: 2rpx solid #FFD95A;
}
.start-title {
  color: #29281F;
}
.start-text {
  font-size: 27rpx;
  color: #8f896d;
  line-height: 1.7;
  font-weight: 500;
}

/* 警示卡 - 深墨底明黄文字 */
.warn-card {
  background: #29281F;
  border: 2rpx solid #29281F;
}
.warn-title {
  color: #FFD95A;
}
.warn-item {
  font-size: 27rpx;
  color: #ffe994;
  line-height: 1.7;
  padding: 8rpx 0;
  font-weight: 500;
}

/* 免责声明 */
.disclaimer {
  font-size: 22rpx;
  color: #8f896d;
  line-height: 1.7;
  padding: 8rpx 12rpx;
  margin-top: 8rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255,253,247,0.95);
  box-shadow: 0 -4rpx 16rpx rgba(41,40,31,0.05);
}

/* 卡片内边距：文字与卡片框匹配（全局 .card 无 padding，此处补齐） */
.card.section {
  padding: 28rpx 30rpx;
  box-sizing: border-box;
}
.card.section .section-title {
  margin-bottom: 16rpx;
}

/* 跟做视频站位（与跟做页一致，开发统一制作上传） */
.train-video-ph {
  width: 100%;
  height: 420rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #29281F 0%, #3d3a2e 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}
.tv-icon { font-size: 72rpx; opacity: .9; }
.tv-title { font-size: 34rpx; font-weight: 800; color: #FFD95A; }
.tv-tip { font-size: 24rpx; color: rgba(255,255,255,.6); }
