<!-- pages/contact/contact.wxml -->
<view class="page-no-tab contact-page">
  <!-- 顶部安全区 + 返回（自定义导航栏规范） -->
  <view class="status-bar" style="height:{{safeTop}}px"></view>
  <view class="fa-nav">
    <view class="fa-back" bindtap="goBack">‹</view>
    <view class="page-header-left">
      <text class="header-kicker">{{lang === 'en' ? 'Emergency care guide' : '紧急照护指引'}}</text>
      <view class="header-title header-title-sub">{{lang === 'en' ? 'Emergency contacts' : '紧急联系人'}}</view>
    </view>
  </view>


  <!-- 顶部 120 快捷卡 -->
  <view class="call120-card" bindtap="onCall120">
    <view class="call120-left">
      <text class="call120-num">120</text>
      <text class="call120-label">{{lang === 'en' ? 'Emergency line · call in a crisis' : '急救电话 · 紧急情况请拨打'}}</text>
    </view>
    <text class="call120-btn">{{lang === 'en' ? '☎ Call' : '☎ 拨打'}}</text>
  </view>

  <!-- 联系人列表 -->
  <view class="contact-list" wx:if="{{hasContacts}}">
    <view class="list-title">{{lang === 'en' ? 'My emergency contacts' : '我的紧急联系人'}}</view>
    <view
      class="contact-card"
      wx:for="{{contacts}}"
      wx:key="id"
      wx:for-item="item"
      data-id="{{item.id}}"
    >
      <view class="contact-avatar">{{item.avatar}}</view>
      <view class="contact-info">
        <view class="contact-name-row">
          <text class="contact-name">{{item.name}}</text>
          <text class="contact-relation">{{item.relationLabel || item.relation}}</text>
        </view>
        <text class="contact-phone">{{item.phone}}</text>
      </view>
      <view class="contact-actions">
        <view class="contact-act-btn call" data-id="{{item.id}}" bindtap="onCall">{{lang === 'en' ? 'Call' : '拨打'}}</view>
        <view class="contact-act-btn edit" data-id="{{item.id}}" bindtap="onEdit">{{lang === 'en' ? 'Edit' : '编辑'}}</view>
        <view class="contact-act-btn del" data-id="{{item.id}}" bindtap="onDelete">{{lang === 'en' ? 'Delete' : '删除'}}</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📞</text>
    <text class="empty-text">{{lang === 'en' ? 'No emergency contacts yet' : '还没有紧急联系人'}}</text>
    <text class="empty-sub">{{lang === 'en' ? 'Add family and doctors so you can call them in one tap' : '添加家人、医生的电话，紧急时刻一键拨打'}}</text>
  </view>

  <!-- 提示 -->
  <view class="contact-tip">
    <text class="tip-line">• {{lang === 'en' ? 'Contacts stay on this device only' : '联系人仅保存在本机，请放心填写'}}</text>
    <text class="tip-line">• {{lang === 'en' ? 'We suggest at least 2 family members and 1 nearby doctor' : '建议至少添加 2 位家人 + 1 位就近医生'}}</text>
  </view>

  <!-- 底部添加按钮 -->
  <view class="bottom-bar">
    <button class="btn-primary btn-big" bindtap="onAdd">{{lang === 'en' ? '+ Add an emergency contact' : '+ 添加紧急联系人'}}</button>
  </view>

</view>
