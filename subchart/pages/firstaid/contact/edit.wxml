<!-- pages/contact/edit.wxml -->
<view class="page-no-tab edit-page">
  <!-- 顶部安全区 + 返回（自定义导航栏规范） -->
  <view class="status-bar" style="height:{{safeTop}}px"></view>
  <view class="fa-nav">
    <view class="fa-back" bindtap="goBack">‹</view>
  </view>


  <view class="form-card">
    <!-- 姓名 -->
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input
        class="form-input"
        placeholder="请输入姓名"
        placeholder-class="form-placeholder"
        value="{{name}}"
        bindinput="onNameInput"
        maxlength="20"
      />
    </view>

    <!-- 关系 -->
    <view class="form-item">
      <text class="form-label">关系</text>
      <picker mode="selector" range="{{relations}}" value="{{relationIndex}}" bindchange="onRelationChange">
        <view class="form-picker">
          <text class="form-picker-value">{{relation}}</text>
          <text class="form-picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <!-- 电话 -->
    <view class="form-item">
      <text class="form-label">电话</text>
      <input
        class="form-input"
        placeholder="请输入11位手机号"
        placeholder-class="form-placeholder"
        type="number"
        value="{{phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>
  </view>

  <!-- 说明 -->
  <view class="form-tip">
    <text class="tip-line">• 电话仅保存在本机，不会上传</text>
    <text class="tip-line">• 建议填家人 + 就近医院/社区医生电话</text>
  </view>

  <!-- 保存 -->
  <view class="bottom-bar">
    <button class="btn-primary btn-big" bindtap="onSave" disabled="{{saving}}">
      {{saving ? '保存中...' : (isEdit ? '保存修改' : '添加联系人')}}
    </button>
  </view>

</view>
