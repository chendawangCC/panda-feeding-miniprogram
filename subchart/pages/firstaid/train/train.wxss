  height: 110rpx;
  border-radius: 50%;
  background: #FFD95A;
}


/* ---- 阅读示意 ---- */
.a-read-book {
  width: 200rpx;
  height: 150rpx;
  background: #29281F;
  border-radius: 12rpx;
  position: relative;
}
.a-read-page {
  position: absolute;
  top: 20rpx;
  bottom: 20rpx;
  left: 50%;
  width: 4rpx;
  background: #FFD95A;
  opacity: 0.6;
}


/* 按压节拍圆 - 深墨底（覆盖在动画上的数字） */
.beat-circle {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(41,40,31,0.92);
  color: #FFD95A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(41,40,31,0.25);
}
.beat-circle.beat-on {
  background: #FFD95A;
  color: #29281F;
  animation: beatPulse 0.55s ease-in-out infinite;
}
.beat-count {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  text-align: center;
}
.beat-target {
  font-size: 18rpx;
  opacity: 0.75;
  margin-top: 2rpx;
  text-align: center;
}
.beat-hint {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #8f896d;
  font-weight: 500;
  background: rgba(255,253,247,0.95);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  text-align: center;
}

/* 倒计时圆 - 明黄底 */
.count-circle {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 4rpx solid #FFD95A;
  background: rgba(255,253,247,0.95);
  color: #29281F;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
  animation: countPulse 1s ease-in-out infinite;
}
.count-num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  text-align: center;
}
.count-unit {
  font-size: 18rpx;
  margin-left: 4rpx;
  font-weight: 500;
}

/* 步骤说明 */
.step-info {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(41,40,31,0.05);
}
.step-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #29281F;
  margin-bottom: 14rpx;
}
.step-desc {
  font-size: 28rpx;
  color: #66635a;
  line-height: 1.7;
}

/* 操作区 */
.action-area {
  margin-top: 40rpx;
}
.ctrl-row {
  display: flex;
  gap: 24rpx;
}
.ctrl-row button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 完成页遮罩 */
.done-mask {
  position: fixed;
  inset: 0;
  background: rgba(41,40,31,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  padding: 40rpx;
  box-sizing: border-box;
}
.done-card {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  background: #FFFDF7;
  border-radius: 32rpx;
  padding: 48rpx 36rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
}
.done-icon {
  font-size: 96rpx;
}
.done-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #29281F;
  margin-top: 16rpx;
}
.done-sub {
  font-size: 28rpx;
  color: #8f896d;
  margin-top: 8rpx;
}
.done-cheer {
  display: inline-block;
  margin-top: 16rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #FFD95A;
  color: #29281F;
  font-size: 28rpx;
  font-weight: 700;
}
.done-points {
  text-align: left;
  margin: 32rpx 0;
}
.done-point-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #29281F;
  margin-bottom: 12rpx;
}
.done-point {
  font-size: 26rpx;
  color: #66635a;
  line-height: 1.7;
  padding: 6rpx 0;
}
.done-point.warn {
  color: #FFD95A;
}
.done-warn {
  text-align: left;
  background: #29281F;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 32rpx;
}
.done-warn .done-point-title {
  color: #FFD95A;
}
.done-card button {
  margin-top: 20rpx;
}

/* keep 跟练节奏动画：节拍脉冲 + 倒计时轻脉冲 */
@keyframes beatPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}
@keyframes countPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}
