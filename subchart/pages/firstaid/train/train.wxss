/* pages/train/train.wxss - 品牌色：米白 FFFDF7 / 明黄 FFD95A / 深墨 29281F */
.train-page {
  padding-bottom: 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 20rpx;
}
.skill-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #29281F;
}
.top-right {
  display: flex;
  align-items: center;
}
.round-text {
  font-size: 26rpx;
  color: #29281F;
  background: #FFD95A;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 700;
}

/* 进度条 */
.progress-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}
.progress-track {
  flex: 1;
  height: 14rpx;
  background: #eee7d6;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFD95A, #FFB800);
  border-radius: 8rpx;
}
.progress-text {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #8f896d;
  min-width: 90rpx;
  text-align: right;
}

/* 真人教学入口 */

/* 主体大圆 */

.stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 560rpx;
  padding: 20rpx 0;
}

/* ===== 跟练动画示意层 ===== */
.anim-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
}
.anim-scene {
  position: relative;
  width: 440rpx;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.anim-label {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #FFD95A;
  color: #29281F;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 22rpx;
  border-radius: 24rpx;
  z-index: 5;
  white-space: nowrap;
}

/* 计数数字覆盖层（压在动画之上） */
/* 跟做视频站位（开发统一制作上传，keep 跟练模式） */
.train-video-ph {
  width: 100%;
  height: 420rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #29281F 0%, #3d3a2e 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}
.tv-icon { font-size: 72rpx; opacity: .9; }
.tv-title { font-size: 34rpx; font-weight: 800; color: #FFD95A; }
.tv-tip { font-size: 24rpx; color: rgba(255,255,255,.6); }

.step-image {
  width: 100%;
  height: 420rpx;
  border-radius: 28rpx;
  background: #fff;
  box-sizing: border-box;
}

.anim-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

/* ---- 心肺复苏按压 ---- */
.a-press-body {
