/* pages/account/account.wxss - 品牌色：米白 FFFDF7 / 明黄 FFD95A / 深墨 29281F */

/* 用户卡片 */
.user-card {
  background: #29281F;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}
.user-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 16rpx;
  background: transparent;
  color: #29281F;
  font-size: 46rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}
.user-avatar-img {
  background: transparent;
  overflow: hidden;
}
.user-info {
  flex: 1;
  min-width: 0;
}
.user-nickname {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
}
.user-phone {
  font-size: 26rpx;
  color: #e8e1d0;
  margin-top: 8rpx;
}
.user-badge {
  background: #FFD95A;
  color: #29281F;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}

/* 功能入口卡片 */
.action-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(41,40,31,0.05);
}
.action-card:active { transform: scale(0.98); }
.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #fff9e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.action-info { flex: 1; min-width: 0; }
.action-title { font-size: 30rpx; font-weight: 700; color: #29281F; }
.action-desc { font-size: 23rpx; color: #8f896d; margin-top: 6rpx; line-height: 1.4; }
.action-arrow { color: #e8e1d0; font-size: 44rpx; margin-left: 12rpx; }

.btn-danger {
  background: #fff;
  color: #C8102E;
  border: 2rpx solid #f0c9c4;
  border-radius: 20rpx;
  height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 30rpx;
  line-height: 92rpx;
}

/* 注册表单 */
.form-head { text-align: center; padding: 40rpx 0 36rpx; }
.form-title { font-size: 44rpx; font-weight: 800; color: #29281F; }
.form-sub { font-size: 24rpx; color: #8f896d; margin-top: 12rpx; }

/* 微信一键登录 */
.btn-wechat {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #fff;
  color: #29281f;
  border: 2rpx solid #e4ddd0;
  border-radius: 20rpx;
  height: 100rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 100rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.btn-wechat[disabled] {
  background: #f2efe4;
  color: #b0a98e;
}
.btn-wechat-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}
.wechat-tip {
  text-align: center;
  font-size: 22rpx;
  color: #8f896d;
  margin-top: 16rpx;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin: 36rpx 0 30rpx;
}
.divider-line {
  flex: 1;
  height: 2rpx;
  background: #ece5d0;
}
.divider-text {
  font-size: 24rpx;
  color: #8f896d;
  margin: 0 24rpx;
  flex-shrink: 0;
}

.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 6rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(41,40,31,0.05);
}
.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 2rpx solid #f6f3eb;
}
.form-item:last-child { border-bottom: none; }
.form-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #29281F;
  width: 130rpx;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #29281F;
}
.form-placeholder { color: #e8e1d0; }

.form-tip {
  background: #f6f3eb;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 36rpx;
}
.tip-line {
  font-size: 23rpx;
  color: #8f896d;
  display: block;
  line-height: 1.7;
}

.btn-primary {
  background: #FFD95A;
  color: #29281F;
  border: none;
  border-radius: 20rpx;
  font-weight: 800;
}
.btn-big { height: 96rpx; font-size: 32rpx; line-height: 96rpx; }
