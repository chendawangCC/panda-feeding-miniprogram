<!-- pages/baby/baby.wxml -->
<view class="page-no-tab">
  <!-- 顶部安全区 + 返回（自定义导航栏规范） -->
  <view class="status-bar" style="height:{{safeTop}}px"></view>
  <view class="fa-nav">
    <view class="fa-back" bindtap="goBack">‹</view>
    <view class="page-header-left">
      <text class="header-kicker">紧急照护指引</text>
      <view class="header-title header-title-sub">宝宝信息</view>
    </view>
  </view>


  <!-- ===== 列表模式 ===== -->
  <block wx:if="{{mode === 'list'}}">

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!hasBabies}}">
      <image class="empty-logo" src="/subchart/pages/firstaid/images/firstaid-logo.png" mode="aspectFit"></image>
      <view class="empty-title">还没有宝宝信息</view>
      <view class="empty-sub">添加宝宝后，首页会按月龄自动推荐合适的护理与急救技能</view>
    </view>

    <!-- 宝宝列表 -->
    <block wx:else>
      <view class="list-head">
        <view class="list-title">我的宝宝</view>
        <view class="list-tip">月龄每天自动更新</view>
      </view>
      <view
        class="baby-card {{item.id === activeId ? 'active' : ''}}"
        wx:for="{{babies}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSelectBaby"
      >
        <view class="baby-avatar">{{item.avatar}}</view>
        <view class="baby-info">
          <view class="baby-name-row">
            <text class="baby-name">{{item.name}}</text>
            <text class="baby-current" wx:if="{{item.id === activeId}}">当前</text>
          </view>
          <view class="baby-meta">{{item.genderLabel}} · {{item.birthDate}}</view>
          <view class="baby-age">{{item.ageText}}</view>
        </view>
        <view class="baby-ops">
          <view class="baby-op edit" data-id="{{item.id}}" catchtap="onEdit">编辑</view>
          <view class="baby-op del" data-id="{{item.id}}" catchtap="onDelete">删除</view>
        </view>
      </view>
    </block>

    <!-- 说明 -->
    <view class="form-tip">
      <text class="tip-line">• 宝宝信息仅保存在本机，不会上传</text>
      <text class="tip-line">• 月龄根据出生日期实时计算，首页推荐随之自动更新</text>
      <text class="tip-line">• 可添加多个宝宝，点击卡片即可切换当前宝宝</text>
    </view>

    <!-- 添加按钮 -->
    <button class="btn-primary btn-big" bindtap="onAdd">+ 添加宝宝</button>
  </block>

  <!-- ===== 表单模式 ===== -->
  <block wx:else>
    <view class="form-head">
      <view class="form-title">{{isEdit ? '编辑宝宝' : '添加宝宝'}}</view>
      <view class="form-sub">填写性别与出生日期，用于首页技能推荐</view>
    </view>

    <view class="form-card">
      <!-- 宝宝昵称 -->
      <view class="form-item">
        <text class="form-label">宝宝昵称</text>
        <input
          class="form-input"
          placeholder="选填，默认叫宝宝"
          placeholder-class="form-placeholder"
          value="{{name}}"
          bindinput="onNameInput"
          maxlength="10"
        />
      </view>

      <!-- 性别 -->
      <view class="form-item">
        <text class="form-label">性别</text>
        <picker mode="selector" range="{{genders}}" value="{{genderIndex}}" bindchange="onGenderChange">
          <view class="form-picker {{genderIndex === -1 ? 'placeholder' : ''}}">
            <text>{{genderIndex === -1 ? '请选择宝宝性别' : genders[genderIndex]}}</text>
            <text class="form-picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <!-- 出生日期 -->
      <view class="form-item">
        <text class="form-label">出生日期</text>
        <picker mode="date" value="{{birthDate}}" end="{{today}}" bindchange="onBirthDateChange">
          <view class="form-picker {{birthDate ? '' : 'placeholder'}}">
            <text>{{birthDate || '请选择出生日期'}}</text>
            <text class="form-picker-arrow">▾</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 操作 -->
    <button class="btn-primary btn-big" bindtap="onSave">{{isEdit ? '保存修改' : '添加宝宝'}}</button>
    <button class="btn-clear" bindtap="onBackToList">返回列表</button>
  </block>

</view>
