page {
  background: #f6f1e5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  color: #29281f;
}
.page-no-tab {
  height: 100vh;
  padding: 0 32rpx 128rpx; /* 左右16pt + 底部手势安全区34pt */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.status-bar {
  height: 176rpx; /* 导航禁止进入区 */
}

/* ==================== 顶部导航 ==================== */
.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  flex-shrink: 0;
}
/* back-btn 使用全局标准样式（72rpx 米灰圆角） */
.nav-title {
  font-size: 26rpx;
  color: #8f896d;
  margin-left: 8rpx;
}

.body-scroll {
  flex: 1;
  min-height: 0;
}

/* ==================== 文章头 ==================== */
.article-head {
  padding: 24rpx 8rpx 8rpx;
}
.article-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #806c2e;
  background: #fff2b9;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
}
.article-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #29281f;
  line-height: 1.3;
}
.article-intro {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8f896d;
  line-height: 1.7;
}

/* ==================== 正文段落 ==================== */
.article-section {
  margin-top: 40rpx;
  background: #fffdf7;
  border-radius: 28rpx;
  padding: 32rpx;
}
.sec-h {
  font-size: 30rpx;
  font-weight: 800;
  color: #29281f;
}
.sec-list {
  margin-top: 20rpx;
}
.sec-item {
  display: flex;
  margin-bottom: 20rpx;
}
.sec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e2a93a;
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.sec-text {
  flex: 1;
  font-size: 26rpx;
  color: #4a4636;
  line-height: 1.7;
}

/* ==================== 温馨提示 ==================== */
.tips-card {
  margin-top: 40rpx;
  background: #fff2b9;
  border-radius: 28rpx;
  padding: 32rpx;
}
.tips-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #5c4a10;
}
.tips-text {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b5c30;
  line-height: 1.7;
}

.bottom-space {
  height: 80rpx;
}
