}
.gd-btn.ghost {
  background: #fffdf7;
  border: 2rpx solid #e0d8c0;
  color: #4a432b;
}
.gd-btn.ghost.on {
  background: #fff2b9;
  border-color: #ffd95a;
  color: #b97b05;
}
.gd-btn.solid {
  background: #ffd95a;
  color: #29281f;
}
.gd-tip {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b5ad93;
}

/* 语音录入遮罩 */
/* 语音录入浮层（白卡片+黄麦+声波） */
.voice-overlay {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.35); z-index: 9999;
  display: flex; align-items: center; justify-content: center;
}
.voice-card {
  width: 560rpx; background: #fff; border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.15);
}
.voice-mic-circle {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: #fff2b9;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx; position: relative;
}
.voice-mic-emoji { font-size: 56rpx; }
.voice-mic-img { width: 64rpx; height: 64rpx; }
.voice-waves {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 40rpx;
  margin-top: -4rpx;
  margin-bottom: 12rpx;
}
.wave-bar {
  width: 8rpx;
  height: 14rpx;
  border-radius: 6rpx;
  background: #ffd95a;
  animation: wave-bounce 0.9s ease-in-out infinite;
}
.wave-bar:nth-child(1) { animation-delay: 0s; }
.wave-bar:nth-child(2) { animation-delay: 0.12s; }
.wave-bar:nth-child(3) { animation-delay: 0.24s; }
.wave-bar:nth-child(4) { animation-delay: 0.36s; }
.wave-bar:nth-child(5) { animation-delay: 0.48s; }
@keyframes wave-bounce {
  0%, 100% { height: 14rpx; }
  50% { height: 40rpx; }
}
.voice-title { font-size: 36rpx; font-weight: 700; color: #2c2c2c; margin-bottom: 8rpx; }
.voice-sub { font-size: 26rpx; color: #8f896d; margin-bottom: 16rpx; }
.voice-tips {
  margin-top: 24rpx; padding: 20rpx 24rpx;
  background: #fffbf0; border-radius: 16rpx; width: 100%;
  display: flex; flex-direction: column; gap: 4rpx;
}
.voice-tips-title { font-size: 22rpx; color: #b97b05; font-weight: 600; margin-bottom: 4rpx; }
.voice-tips-line { font-size: 22rpx; color: #8f896d; line-height: 1.5; }

.voice-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(41, 40, 31, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.voice-mask-inner {
  width: 320rpx;
  height: 320rpx;
  border-radius: 32rpx;
  background: #FFFDF7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.voice-mic { font-size: 88rpx; }
.voice-txt { font-size: 32rpx; font-weight: 800; color: #29281F; }
.voice-sub { font-size: 24rpx; color: #8f896d; }
.voice-tips {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: rgba(255,255,255,0.85);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
